<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.mapper.EmployeeMapper">

    <!-- 字段映射：解决 emp_name -> empName 等下划线转驼峰 -->
    <resultMap id="empResultMap" type="com.example.entity.Employee">
        <id     property="empId"    column="emp_id"/>
        <result property="empName"  column="emp_name"/>
        <result property="gender"   column="gender"/>
        <result property="dept"     column="dept"/>
        <result property="post"     column="post"/>
        <result property="salary"   column="salary"/>
        <result property="hireDate" column="hire_date"/>
        <result property="status"   column="status"/>
    </resultMap>

    <!-- 公共字段片段，避免重复书写 -->
    <sql id="empColumns">
        emp_id, emp_name, gender, dept, post, salary, hire_date, status
    </sql>

    <!-- ==================== 基础 CRUD ==================== -->

    <select id="listAll" resultMap="empResultMap">
        SELECT <include refid="empColumns"/> FROM employee ORDER BY emp_id
    </select>

    <select id="getById" parameterType="int" resultMap="empResultMap">
        SELECT <include refid="empColumns"/> FROM employee WHERE emp_id = #{empId}
    </select>

    <!-- 新增并回填自增主键到 empId 属性 -->
    <insert id="save" parameterType="com.example.entity.Employee"
            useGeneratedKeys="true" keyProperty="empId">
        INSERT INTO employee (emp_name, gender, dept, post, salary, hire_date, status)
        VALUES (#{empName}, #{gender}, #{dept}, #{post}, #{salary}, #{hireDate}, #{status})
    </insert>

    <update id="modify" parameterType="com.example.entity.Employee">
        UPDATE employee
        SET emp_name = #{empName},
            gender   = #{gender},
            dept     = #{dept},
            post     = #{post},
            salary   = #{salary},
            hire_date= #{hireDate},
            status   = #{status}
        WHERE emp_id = #{empId}
    </update>

    <delete id="removeById" parameterType="int">
        DELETE FROM employee WHERE emp_id = #{empId}
    </delete>

    <!-- ==================== 动态 SQL ==================== -->

    <!-- if + where：多条件任意组合，where 自动剔除首个 AND -->
    <select id="searchByCondition" parameterType="com.example.entity.Employee" resultMap="empResultMap">
        SELECT <include refid="empColumns"/> FROM employee
        <where>
            <if test="empName != null and empName != ''">
                AND emp_name LIKE CONCAT('%', #{empName}, '%')
            </if>
            <if test="gender != null and gender != ''">
                AND gender = #{gender}
            </if>
            <if test="dept != null and dept != ''">
                AND dept = #{dept}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY emp_id
    </select>

    <!-- set 标签：只更新非空字段，自动去掉末尾逗号 -->
    <update id="patchById" parameterType="com.example.entity.Employee">
        UPDATE employee
        <set>
            <if test="empName != null">emp_name = #{empName},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="dept != null">dept = #{dept},</if>
            <if test="post != null">post = #{post},</if>
            <if test="salary != null">salary = #{salary},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE emp_id = #{empId}
    </update>

    <!-- foreach 批量删除：IN (1,2,3) -->
    <delete id="removeBatch">
        DELETE FROM employee WHERE emp_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- foreach 批量新增：多行 VALUES -->
    <insert id="saveBatch">
        INSERT INTO employee (emp_name, gender, dept, post, salary, hire_date, status) VALUES
        <foreach collection="list" item="e" separator=",">
            (#{e.empName}, #{e.gender}, #{e.dept}, #{e.post}, #{e.salary}, #{e.hireDate}, #{e.status})
        </foreach>
    </insert>

    <!-- choose/when/otherwise：互斥分支，只命中第一个满足条件 -->
    <select id="pickOne" parameterType="com.example.entity.Employee" resultMap="empResultMap">
        SELECT <include refid="empColumns"/> FROM employee
        <where>
            <choose>
                <when test="empId != null">
                    AND emp_id = #{empId}
                </when>
                <when test="empName != null and empName != ''">
                    AND emp_name = #{empName}
                </when>
                <when test="dept != null and dept != ''">
                    AND dept = #{dept}
                </when>
                <otherwise>
                    AND status = 1
                </otherwise>
            </choose>
        </where>
    </select>

</mapper>
