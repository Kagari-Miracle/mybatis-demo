<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.mapper.Chapter03UserMapper">

    <!-- ═══════════════════════════════════════════════════
         第一部分：XML ResultMap（注解方式通过 @ResultMap 引用此 ID）
         ═══════════════════════════════════════════════════ -->
    <resultMap id="userResultMap" type="com.example.entity.User">
        <id     property="id"          column="id"/>
        <result property="username"    column="username"/>
        <result property="password"    column="password"/>
        <result property="email"       column="email"/>
        <result property="createTime"  column="create_time"/>
        <result property="updateTime"  column="update_time"/>
    </resultMap>

    <!-- ═══════════════════════════════════════════════════
         第二部分：动态 SQL
         ═══════════════════════════════════════════════════ -->

    <!-- 1. <if> + <where> 条件查询 -->
    <select id="findUsersByCondition" parameterType="com.example.entity.User"
            resultMap="userResultMap">
        SELECT * FROM user
        <where>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="email != null and email != ''">
                AND email = #{email}
            </if>
            <if test="id != null">
                AND id = #{id}
            </if>
        </where>
    </select>

    <!-- 2. <set> 动态更新（自动加 SET、去末尾逗号） -->
    <update id="updateUserSelective" parameterType="com.example.entity.User">
        UPDATE user
        <set>
            <if test="username != null">username = #{username},</if>
            <if test="password != null">password = #{password},</if>
            <if test="email != null">email = #{email},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 3. <choose>/<when>/<otherwise> 互斥分支 -->
    <select id="findUserPriority" parameterType="com.example.entity.User"
            resultMap="userResultMap">
        SELECT * FROM user
        <where>
            <choose>
                <when test="id != null">
                    id = #{id}
                </when>
                <when test="username != null and username != ''">
                    username LIKE CONCAT('%', #{username}, '%')
                </when>
                <when test="email != null and email != ''">
                    email = #{email}
                </when>
                <otherwise>
                    1 = 1
                </otherwise>
            </choose>
        </where>
    </select>

    <!-- 4. <foreach> 批量查询（IN 条件） -->
    <select id="findByIds" resultMap="userResultMap" parameterType="arraylist">
        SELECT * FROM user
        WHERE id IN
        <foreach collection="ids" item="id"
                 open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 5. <foreach> 批量插入 -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO user(username, password, email, create_time, update_time)
        VALUES
        <foreach collection="list" item="u" separator=",">
            (#{u.username}, #{u.password}, #{u.email}, #{u.createTime}, #{u.updateTime})
        </foreach>
    </insert>

    <!-- 6. <trim> 自定义裁剪 -->
    <select id="findUsersByTrim" parameterType="com.example.entity.User"
            resultMap="userResultMap">
        SELECT * FROM user
        <trim prefix="WHERE" prefixOverrides="AND |OR ">
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="email != null and email != ''">
                AND email = #{email}
            </if>
        </trim>
    </select>

    <!-- 7. <sql>/<include> 复用 SQL 片段 -->
    <sql id="userColumns">
        id, username, password, email, create_time, update_time
    </sql>

    <sql id="commonWhereCondition">
        <if test="username != null and username != ''">
            AND username LIKE CONCAT('%', #{username}, '%')
        </if>
        <if test="email != null and email != ''">
            AND email = #{email}
        </if>
    </sql>

    <select id="findUsersWithInclude" parameterType="com.example.entity.User"
            resultMap="userResultMap">
        SELECT <include refid="userColumns"/> FROM user
        <where>
            <include refid="commonWhereCondition"/>
        </where>
    </select>

</mapper>
